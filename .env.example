# Copy to apps/backend/.env and apps/storefront/.env.local as needed. Never commit real values.

# --- Infrastructure ---
DATABASE_URL=postgres://libaas:libaas@localhost:5432/libaas
REDIS_URL=redis://localhost:6379
HOLD_TTL_MINUTES=15

# --- Medusa core ---
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:7001
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=libaasadmin
S3_SECRET_ACCESS_KEY=libaasadmin
S3_PUBLIC_BUCKET=libaas-public
S3_PRIVATE_BUCKET=libaas-private
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@libaas.local

# --- Payments (simulated wallet is always on; Stripe optional) ---
SIMULATED_WALLET_WEBHOOK_SECRET=whsec_simulated_local
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed / local demo ---
SEED_ADMIN_EMAIL=admin@libaas.local
SEED_ADMIN_PASSWORD=supersecret
DB_USERNAME=libaas
DB_PASSWORD=libaas
DB_HOST=localhost
