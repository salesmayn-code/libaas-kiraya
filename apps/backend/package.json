{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Libaas Kiraya Medusa backend",
  "license": "MIT",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate",
    "db:sync-links": "medusa db:sync-links",
    "db:setup": "medusa db:migrate && medusa db:sync-links",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "test": "pnpm test:unit && pnpm test:integration:modules",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@medusajs/admin-sdk": "2.22.0",
    "@medusajs/admin-shared": "2.22.0",
    "@medusajs/caching": "2.22.0",
    "@medusajs/cli": "2.22.0",
    "@medusajs/dashboard": "2.22.0",
    "@medusajs/draft-order": "2.22.0",
    "@medusajs/framework": "2.22.0",
    "@medusajs/js-sdk": "2.22.0",
    "@medusajs/medusa": "2.22.0",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.0",
    "@medusajs/test-utils": "2.22.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "fast-check": "^4.2.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
